# Local native Streamlit. For Docker Compose, the compose environment uses host.docker.internal.
MIROFISH_MODE = "local"
MIROFISH_API_URL = "http://localhost:5001"
MIROFISH_FRONTEND_URL = "http://localhost:3000"

# Optional. Use only when the HTTPS reverse proxy protecting a hosted MiroFish deployment
# expects a bearer token. Never commit the actual token.
# MIROFISH_API_TOKEN = ""

# Optional Cloudflare Access service authentication for Streamlit server requests.
# Configure an Access service-token policy for the MiroFish hostname first.
# MIROFISH_ACCESS_CLIENT_ID = ""
# MIROFISH_ACCESS_CLIENT_SECRET = ""
